<?xml version="1.0" encoding="utf-8"?>
<!-- ST10452404 OPSC6312 ICE TASK 2 -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.centralink.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.centralink.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.centralink.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_services"
            app:destination="@id/servicesFragment"/>
        <action
            android:id="@+id/action_homeFragment_to_announcementsFragment"
            app:destination="@id/announcementsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_userListFragment"
            app:destination="@id/userListFragment" />
    </fragment>

    <fragment
        android:id="@+id/servicesFragment"
        android:name="com.example.centralink.ServicesFragment"
        android:label="Services"/>

    <fragment
        android:id="@+id/announcementsFragment"
        android:name="com.example.centralink.AnnouncementsFragment"
        android:label="@string/menu_deliveries" />

    <fragment
        android:id="@+id/userListFragment"
        android:name="com.example.centralink.UserListFragment"
        android:label="Registered Users" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.centralink.MapFragment"
        android:label="Map" />

</navigation>